// Prisma Schema for FreeInvoice
// Author: Senior AI Engineering Collaborator

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  clients       Client[]
  invoices      Invoice[]
  templates     InvoiceTemplate[]
  
  // SaaS Logic: Pro (1-for-3 impact model)
  subscriptionType String @default("free") // free, pro, agency
  
  // Stripe Integration
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?
  
  // Usage Tracking
  invoicesThisMonth    Int       @default(0)
  lastInvoiceReset     DateTime? @default(now())
  
  // Social Impact Tracking
  creditsGenerated Int @default(0) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Client {
  id        String    @id @default(cuid())
  userId    String
  name      String
  email     String
  address   String?
  invoices  Invoice[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String
  clientId    String
  templateId  String?  // Reference to custom template
  number      String
  date        DateTime @default(now())
  dueDate     DateTime
  items       String     // JSON string for SQLite
  taxRate     Float    @default(0)
  total       Float
  status      String   @default("draft") // draft, sent, paid, overdue
  notes       String?   // Invoice notes
  
  // Payment tracking (Late Payment Prediction Engine)
  paidDate    DateTime?  // When invoice was actually paid
  paymentDelay Int?      // Calculated days between dueDate and paidDate (negative = early)
  
  // Embedded payment links (Mollie / Stripe)
  paymentUrl   String?
  paymentMethod String?   // mollie, stripe, etc.
  
  // Recurring invoice fields (Phase 3)
  isRecurring Boolean  @default(false)
  recurringInterval String?
  recurringDay Int?
  nextInvoiceDate DateTime?
  recurringEndDate DateTime?
  parentInvoiceId String?
  
  user        User           @relation(fields: [userId], references: [id])
  client      Client         @relation(fields: [clientId], references: [id])
  template    InvoiceTemplate? @relation(fields: [templateId], references: [id])
  paymentHistory PaymentHistory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Payment history for ML-powered late payment prediction
model PaymentHistory {
  id              String   @id @default(cuid())
  invoiceId       String   @unique
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  // Client payment behavior patterns
  avgPaymentDelay Float   @default(0)  // Average days client pays early/late
  paymentCount    Int     @default(0)   // Number of past invoices for this client
  onTimeRate      Float   @default(1)  // Percentage of invoices paid on/before dueDate
  
  // Calculated risk score (0-100, higher = more likely to pay late)
  riskScore       Int     @default(0)
  
  // Prediction data
  predictedPayDate DateTime?
  predictedRisk    String?  // low, medium, high
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([invoiceId])
  @@index([riskScore])
}

// Professional Invoice Template System
model InvoiceTemplate {
  id          String   @id @default(cuid())
  userId     String?   // null for system templates, user ID for custom templates
  name        String    // "Professional Blue", "Minimalist", etc.
  description String?
  language    String    @default("en") // en, nl, de, fr, es, etc.
  currency    String    @default("EUR")
  currencySymbol String @default("\u20ac")
  currencyPosition String @default("before") // before or after amount
  
  // Template Type
  isDefault   Boolean  @default(false)  // System default template
  isPublic    Boolean  @default(false)  // Available to all users (Agency feature)
  isPremium   Boolean  @default(false)  // Premium template (Pro/Agency only)
  
  // Labels (JSON object with all translatable labels)
  labels      String   // JSON: { invoice: "INVOICE", subtotal: "Subtotal", ... }
  
  // Styling
  primaryColor   String @default("#4f46e5")  // Indigo
  secondaryColor String @default("#1f2937")  // Gray-800
  accentColor    String @default("#10b981")  // Emerald
  fontFamily     String @default("Helvetica")
  borderRadius   String @default("16px")
  
  // Layout Options
  showLogo        Boolean @default(true)
  showPaymentInfo Boolean @default(true)
  showNotes       Boolean @default(true)
  showTerms       Boolean @default(true)
  showImpactBadge Boolean @default(true)
  
  // Business Info (for white-label)
  senderName    String?
  senderEmail   String?
  senderPhone   String?
  senderWebsite String?
  senderAddress String?
  senderVatNumber String?
  senderBankName String?
  senderIban    String?
  senderBic     String?
  
  // Payment Terms
  paymentTerms String @default("Net 30")
  paymentInstructions String?
  
  // Footer
  footerText   String?
  showSocialImpact Boolean @default(true)
  
  // PDF Options
  pageSize     String @default("A4")
  orientation  String @default("portrait")
  margins      String @default("{\"top\":60,\"right\":60,\"bottom\":60,\"left\":60}")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
  
  @@index([userId])
  @@index([isDefault])
  @@index([language])
}

model SocialImpactCredit {
  id        String   @id @default(cuid())
  sponsorId String?
  beneficiaryId String? @unique
  fundedAt  DateTime @default(now())
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String
  path       String   @default("unknown")
  ip         String   @default("unknown")
  userAgent  String   @default("")
  metadata   String?
  timestamp  DateTime @default(now())

  @@index([eventType])
  @@index([timestamp])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}